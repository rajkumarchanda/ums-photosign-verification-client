{
    "name": "ums-lspl/photosign-verification-client",
    "description": "Laravel client for PhotoSign Verification — validate passport photos and handwritten signatures before storing them.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "photosign",
        "passport",
        "signature",
        "smartexam",
        "validation"
    ],
    "homepage": "https://github.com/rajkumarchanda/ums-photosign-verification-client",
    "support": {
        "issues": "https://github.com/rajkumarchanda/ums-photosign-verification-client/issues",
        "source": "https://github.com/rajkumarchanda/ums-photosign-verification-client"
    },
    "authors": [
        {
            "name": "Raj Kumar Chanda",
            "email": "rajarajkumar.chanda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhotoSign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhotoSign\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhotoSign\\PhotoSignServiceProvider"
            ],
            "aliases": {
                "PhotoSign": "PhotoSign\\Facades\\PhotoSign"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
